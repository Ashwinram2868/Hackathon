# India Weather Intelligence & Prediction Platform
# Server Configuration
PORT=5000
NODE_ENV=development

# Weather Data Provider Configuration
# By default, the application connects to the Open-Meteo High Resolution Numerical Weather Prediction (WMO-compliant) API
# which requires NO external API key and has generous limits.
#
# If you prefer using OpenWeatherMap OneCall or WeatherAPI, you can optionally supply your API key below:
# OPENWEATHER_API_KEY=your_openweather_api_key_here
# WEATHERAPI_KEY=your_weatherapi_key_here

# Cache duration in seconds for weather queries (default: 300s = 5 minutes)
CACHE_TTL_SECONDS=300

# Client Configuration
VITE_API_URL=/api
